# Server
MEDDOC_NODE_ENV=production
MEDDOC_CLIENT_URL=https://your-frontend.vercel.app

# Database
MEDDOC_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Clerk
MEDDOC_CLERK_SECRET_KEY=sk_live_xxxxx

# Google AI (Gemini)
MEDDOC_GOOGLE_API_KEY=AIzaSyxxxxx
MEDDOC_GEMINI_MODEL=gemini-3.1-flash-lite-preview
MEDDOC_GEMINI_EMBEDDING_MODEL=text-embedding-004

# File storage
MEDDOC_UPLOAD_DIR=./uploads
MEDDOC_VECTOR_STORE_DIR=./vector_store

# File Upload
MEDDOC_MAX_FILE_SIZE=10485760

# Encryption key (64-char hex string)
MEDDOC_ENCRYPTION_KEY=your-64-char-hex-string-here
